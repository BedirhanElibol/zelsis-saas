# Zelsis Static Scanner Ignore Configuration
# Excludes test fixtures, temporary development files, and third-party dependencies from SAST audits

# Temporary and Scratch Scripts
scratch/
.agent/
.gemini/

# Test Suites and Synthetic Vulnerability Verification Fixtures
tests/

# Zelsis's own rule definitions, catalogs and demo playgrounds contain vulnerable
# patterns as data. The scanner itself has no hardcoded knowledge of these paths.
lib/rules/
lib/scanner/
lib/scanner-engine.ts
data/catalogs/
data/mockData.ts
data/workspaceFiles.ts
components/dashboard/VulnerabilityPlayground.tsx
components/dashboard/RuleKnowledgeBaseModal.tsx
components/InteractiveAnalyzer.tsx
sql/05_seed_data.sql
# Demo dashboard data and landing-page before/after examples quote vulnerable code as strings
data/demo-data.ts
data/landing-checks.ts
components/dashboard/RuleConfiguratorModal.tsx

# Rule inventory, maturity and benchmark data quote rule titles and the documented
# flaws of vulnerable corpus repos as strings; the scripts that build them are dev-only.
.generated.json
docs/benchmark/
scripts/benchmark/
scripts/gen-secret-fixtures.ts
scripts/rule-audit.ts

# Package Lockfiles (evaluated by SCA dependency analyzer, not SAST code engine)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build Outputs and Caches
.next/
dist/
build/
out/

# SEO guides and the real-bugs page show deliberately buggy code as examples
app/guides/
app/docs/real-world-bugs/

# Language-coverage probes are deliberately vulnerable snippets
scripts/language-coverage.ts
