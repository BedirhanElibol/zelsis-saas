{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/rescan",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "app/api/v1/gate-check/route.ts": {
      "maxDuration": 30
    },
    "app/api/v1/proxy/route.ts": {
      "maxDuration": 30
    },
    "app/api/v1/github-proxy/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/v1/badge",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
